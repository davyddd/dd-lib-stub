[terminal]
output-format = "concise"

[environment]
python-version = "{{ min_python_version }}"
# Path to the environment inside the Docker container (see Dockerfile);
# in CI the reusable workflow overrides it with `ty check --python .venv`.
python = "/usr/local"

[src]
exclude = [
    ".git",
    "__pycache__",
    ".ruff_cache",
    ".pytest_cache",
    ".venv",
    "fabfile.py",
]
